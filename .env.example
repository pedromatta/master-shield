# ---------------------------------------------------------------------------
# Master Shield — environment configuration.
#
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
# ---------------------------------------------------------------------------

# --- PostgreSQL (runs inside the api container, never published) ------------
POSTGRES_USER=master_shield
POSTGRES_PASSWORD=change-me
POSTGRES_DB=master_shield
POSTGRES_PORT=5432

# --- API --------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8090

# --- Web (nginx) ------------------------------------------------------------
# Host port the frontend is published on.
WEB_PORT=8090
# Where nginx forwards /api and /uploads. Compose service name by default.
API_UPSTREAM=http://api:5120

# --- App --------------------------------------------------------------------
# Public base URL used to build password-reset links (the address users open).
APP_PUBLIC_URL=http://localhost:8090

# --- Email (SMTP) -----------------------------------------------------------
# Password-reset links are emailed. Leave EMAIL_HOST empty to disable mail delivery
# (the reset endpoint then reports success without sending anything).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_ENABLE_SSL=true
